   "source": [
    "\"\"\"\n",
    "PCoA + Envfit Analysis\n",
    "Input: Result2.xlsx (contains: city, Cluster, SDG indicators G1.1-G16.5,\n",
    "       and 13 influencing factors)\n",
    "\"\"\"\n",
    "\n",
    "import re\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.patches import Ellipse\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from scipy.spatial.distance import pdist, squareform\n",
    "\n",
    "# =============================================================================\n",
    "# Global font settings — Arial for all plots\n",
    "# =============================================================================\n",
    "plt.rcParams['font.family'] = 'Arial'\n",
    "plt.rcParams['xtick.labelsize'] = 14\n",
    "plt.rcParams['ytick.labelsize'] = 14\n",
    "plt.rcParams['axes.labelsize'] = 16\n",
    "plt.rcParams['legend.fontsize'] = 14\n",
    "\n",
    "RNG = np.random.default_rng(42)\n",
    "\n",
    "# =============================================================================\n",
    "# 1. Load data\n",
    "# =============================================================================\n",
    "# ---- UPDATE THIS PATH ----\n",
    "PATH_DATA = r\"D:\\City SDG paper\\data for governance capacity\\WGI_data_072026\\1_Analysis\\Result2.xlsx\"\n",
    "OUTPUT_DIR = r\"D:\\City SDG paper\\data for governance capacity\\WGI_data_072026\\1_Analysis\"\n",
    "# --------------------------\n",
    "\n",
    "df = pd.read_excel(PATH_DATA)\n",
    "df.columns = [c.strip() for c in df.columns]\n",
    "\n",
    "# Identify SDG indicator columns (G1.1, G1.2, ..., G16.5)\n",
    "sdg_cols = [c for c in df.columns if re.fullmatch(r'G\\d+\\.\\d+', c)]\n",
    "\n",
    "# Identify factor columns — everything except city, Cluster, and SDG indicators\n",
    "non_factor_cols = ['MSA', 'Cluster', 'city', 'num'] + sdg_cols\n",
    "factor_cols = [c for c in df.columns if c not in non_factor_cols]\n",
    "\n",
    "print(f\"SDG indicators: {len(sdg_cols)}\")\n",
    "print(f\"Influencing factors: {len(factor_cols)}\")\n",
    "\n",
    "# Fill NaN with median (safety check)\n",
    "for c in df.columns:\n",
    "    if df[c].dtype in ['float64', 'int64'] and df[c].isna().any():\n",
    "        med = df[c].median()\n",
    "        n_na = df[c].isna().sum()\n",
    "        df[c] = df[c].fillna(med)\n",
    "        print(f\"  Filled {n_na} NaN in '{c}' with median={med:.4f}\")\n",
    "\n",
    "labels = df['Cluster'].values\n",
    "cities = df['city'].values if 'city' in df.columns else df['MSA'].values\n",
    "\n",
    "print(f\"\\nCluster sizes: { {c: int((labels==c).sum()) for c in sorted(set(labels))} }\")\n",
    "\n",
    "# =============================================================================\n",
    "# 2. PCoA (Principal Coordinates Analysis)\n",
    "# =============================================================================\n",
    "Xz = StandardScaler().fit_transform(df[sdg_cols].values)\n",
    "D = squareform(pdist(Xz, metric='euclidean'))\n",
    "n = D.shape[0]\n",
    "\n",
    "J = np.eye(n) - np.ones((n, n)) / n\n",
    "B = -0.5 * J @ (D ** 2) @ J\n",
    "eigvals, eigvecs = np.linalg.eigh(B)\n",
    "idx = np.argsort(eigvals)[::-1]\n",
    "eigvals, eigvecs = eigvals[idx], eigvecs[:, idx]\n",
    "pos = eigvals > 1e-10\n",
    "coords = eigvecs[:, pos] * np.sqrt(eigvals[pos])\n",
    "pc1, pc2 = coords[:, 0], coords[:, 1]\n",
    "\n",
    "ve = eigvals[pos] / eigvals[pos].sum() * 100\n",
    "ve1, ve2 = ve[0], ve[1]\n",
    "print(f\"\\nPCoA1 = {ve1:.2f}%   PCoA2 = {ve2:.2f}%\")\n",
    "\n",
    "# =============================================================================\n",
    "# 3. Envfit (permutation test, 999 permutations)\n",
    "# =============================================================================\n",
    "axes_c = np.column_stack([pc1, pc2]) - np.column_stack([pc1, pc2]).mean(axis=0)\n",
    "\n",
    "def envfit(axes_c, var, n_perm=999):\n",
    "    v = var - var.mean()\n",
    "    beta, *_ = np.linalg.lstsq(axes_c, v, rcond=None)\n",
    "    fitted = axes_c @ beta\n",
    "    r2 = 1 - np.sum((v - fitted)**2) / np.sum(v**2)\n",
    "    norm = np.linalg.norm(beta)\n",
    "    direction = beta / norm if norm > 0 else beta\n",
    "    perm_r2 = np.empty(n_perm)\n",
    "    for i in range(n_perm):\n",
    "        vp = RNG.permutation(v)\n",
    "        bp, *_ = np.linalg.lstsq(axes_c, vp, rcond=None)\n",
    "        perm_r2[i] = 1 - np.sum((vp - axes_c @ bp)**2) / np.sum(vp**2)\n",
    "    p = (np.sum(perm_r2 >= r2) + 1) / (n_perm + 1)\n",
    "    return dict(direction=direction, r2=r2, p=p)\n",
    "\n",
    "# Short display labels for arrows\n",
    "short_labels = {\n",
    "    'POP density (pop/km2)': 'Pop. Density',\n",
    "    'GDP per capita (thousands)': 'GDP per capita',\n",
    "    'Female Population%': 'Female Pop. %',\n",
    "    'Under 15 years old%': 'Under-15 Pop. %',\n",
    "    'Over 65 years old%': 'Over-65 Pop. %',\n",
    "    'GDP_Primary %': 'GDP Primary %',\n",
    "    'GDP_Secondary %': 'GDP Secondary %',\n",
    "    'VOTER_TURNOUT_ratio': 'Voter Turnout',\n",
    "    'Nonprofit per 10k pop': 'Nonprofit Orgs. per 10k',\n",
    "    'AVG_ANNUAL_WAGE': 'Avg. Gov. Annual Wage',\n",
    "    'EXP_GDP_RATIO': 'Direct Exp. / GDP',\n",
    "    'establishment entry rate': 'Estab. Entry Rate',\n",
    "    'Fed Cor Conv per 100k': 'Fed. Corruption per 100k',\n",
    "}\n",
    "\n",
    "env_results = {}\n",
    "print(f\"\\n{'Factor':<32s} {'r²':>6s} {'p':>8s} {'sig':>4s}\")\n",
    "print(\"=\" * 55)\n",
    "for col in factor_cols:\n",
    "    env_results[col] = envfit(axes_c, df[col].values)\n",
    "    r = env_results[col]\n",
    "    sig = ('***' if r['p'] <= 0.001\n",
    "           else '**' if r['p'] < 0.01\n",
    "           else '*' if r['p'] < 0.05\n",
    "           else 'ns')\n",
    "    print(f\"  {col:<30s} {r['r2']:>6.3f} {r['p']:>8.4f} {sig:>4s}\")\n",
    "\n",
    "# =============================================================================\n",
    "# 4. Envfit Figure\n",
    "# =============================================================================\n",
    "CLUSTER_PT   = {1: '#A93226', 2: '#3498DB', 3: '#1F3A5F'}\n",
    "CLUSTER_FILL = {1: '#E8B4B0', 2: '#9CC4E0', 3: '#7891B5'}\n",
    "CLUSTER_EDGE = {1: '#C0392B', 2: '#5DADE2', 3: '#2C3E7A'}\n",
    "\n",
    "def conf_ellipse(xs, ys, ax, cf, ce, n_std=2.0):\n",
    "    cov = np.cov(xs, ys)\n",
    "    vals, vecs = np.linalg.eigh(cov)\n",
    "    o = vals.argsort()[::-1]; vals = vals[o]; vecs = vecs[:, o]\n",
    "    angle = np.degrees(np.arctan2(*vecs[:, 0][::-1]))\n",
    "    w, h = 2 * n_std * np.sqrt(vals)\n",
    "    ax.add_patch(Ellipse((xs.mean(), ys.mean()), w, h, angle=angle,\n",
    "                 facecolor=cf, edgecolor=ce, alpha=0.22, lw=1.2))\n",
    "    ax.add_patch(Ellipse((xs.mean(), ys.mean()), w, h, angle=angle,\n",
    "                 facecolor='none', edgecolor=ce, alpha=0.7, lw=1.6))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(14, 11))\n",
    "\n",
    "# Cluster ellipses\n",
    "for c in sorted(set(labels)):\n",
    "    m = labels == c\n",
    "    conf_ellipse(pc1[m], pc2[m], ax, CLUSTER_FILL[c], CLUSTER_EDGE[c])\n",
    "\n",
    "# Scatter points\n",
    "for c in sorted(set(labels)):\n",
    "    m = labels == c\n",
    "    ax.scatter(pc1[m], pc2[m], s=70, color=CLUSTER_PT[c],\n",
    "               edgecolor='white', linewidth=0.9, zorder=3, label=f'Typology {c}')\n",
    "\n",
    "# MSA labels (small, color-matched)\n",
    "for xi, yi, name, c in zip(pc1, pc2, cities, labels):\n",
    "    ax.text(xi, yi + 0.20, name, fontsize=8, color=CLUSTER_EDGE[c],\n",
    "            alpha=0.9, ha='center', va='bottom', zorder=4)\n",
    "\n",
    "# Crosshair\n",
    "ax.axhline(0, color='gray', lw=0.7, ls='--', alpha=0.45)\n",
    "ax.axvline(0, color='gray', lw=0.7, ls='--', alpha=0.45)\n",
    "\n",
    "# Envfit arrows\n",
    "xr = pc1.max() - pc1.min()\n",
    "yr = pc2.max() - pc2.min()\n",
    "scale = 0.38 * min(xr, yr)\n",
    "\n",
    "for col, r in env_results.items():\n",
    "    dx, dy = r['direction'] * np.sqrt(max(r['r2'], 0)) * scale\n",
    "    p = r['p']\n",
    "    sig = ('***' if p <= 0.001\n",
    "           else '**' if p < 0.01\n",
    "           else '*' if p < 0.05\n",
    "           else '')\n",
    "    is_sig = p < 0.05\n",
    "\n",
    "    ax.annotate('', xy=(dx, dy), xytext=(0, 0),\n",
    "                arrowprops=dict(arrowstyle='->', color='black',\n",
    "                               lw=2.0 if is_sig else 1.0,\n",
    "                               alpha=1.0 if is_sig else 0))\n",
    "\n",
    "    label = f\"{short_labels.get(col, col)} {sig}\".strip()\n",
    "    ax.text(dx * 1.12, dy * 1.12, label, fontsize=16, fontweight='normal',\n",
    "            ha='left' if dx >= 0 else 'right',\n",
    "            va='bottom' if dy >= 0 else 'top',\n",
    "            color='black', alpha=1.0 if is_sig else 0,\n",
    "            bbox=dict(boxstyle='round,pad=0.3', facecolor='white',\n",
    "                      edgecolor='none', alpha=0.65 if is_sig else 0),\n",
    "            zorder=5)\n",
    "\n",
    "ax.set_xlabel(f'PCoA 1 ({ve1:.2f}%)', fontsize=18, fontweight='normal')\n",
    "ax.set_ylabel(f'PCoA 2 ({ve2:.2f}%)', fontsize=18, fontweight='normal')\n",
    "ax.tick_params(axis='both', labelsize=16)\n",
    "ax.grid(True, alpha=0.2, linestyle='--')\n",
    "ax.spines['top'].set_visible(False)\n",
    "ax.spines['right'].set_visible(False)\n",
    "ax.legend(loc='upper right', frameon=True, framealpha=0.95, fontsize=16,\n",
    "          edgecolor='#cccccc')\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "# =============================================================================\n",
    "# 5. Export\n",
    "# =============================================================================\n",
    "import os\n",
    "fig.savefig(os.path.join(OUTPUT_DIR, 'PCoA_envfit.png'),\n",
    "            dpi=200, bbox_inches='tight', facecolor='white')\n",
    "\n",
    "envfit_df = pd.DataFrame([\n",
    "    {'Factor': col, 'r2': r['r2'], 'p_value': r['p'],\n",
    "     'direction_PCoA1': r['direction'][0],\n",
    "     'direction_PCoA2': r['direction'][1],\n",
    "     'significant': r['p'] < 0.05}\n",
    "    for col, r in env_results.items()\n",
    "])\n",
    "envfit_df.to_excel(os.path.join(OUTPUT_DIR, 'envfit_results.xlsx'), index=False)\n",
    "\n",
    "plt.show()\n",
    "print(\"\\nDone. Figure saved as PCoA_envfit.png and results in envfit_results.xlsx\")"
   ]
  },
